# Скопируйте в .env на сервере и заполните (при автодеплое из GitHub файл создаётся сам).

# Адрес, по которому открывается приложение. Если своего домена нет — IP-адрес сервера
# с окончанием .sslip.io, например 203.0.113.10.sslip.io
DOMAIN=kitchen.example.ru
PUBLIC_URL=https://kitchen.example.ru

# Caddy сам получит HTTPS-сертификат на порты 80/443. Если на сервере уже есть nginx —
# оставьте пустым и проксируйте свой домен на 127.0.0.1:APP_PORT.
COMPOSE_PROFILES=caddy
APP_PORT=8080

TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=
ALLOWED_USER_IDS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

TZ=Europe/Moscow
ANTHROPIC_MODEL=claude-opus-5
# Если ANTHROPIC_API_KEY пустой, рецепты, фото и идеи разбирает GPT по ключу OpenAI
OPENAI_MODEL=gpt-5.4-mini

# Если сервер в России: OpenAI и Anthropic не отвечают на российские IP.
# Тогда нужен прокси за рубежом (http://user:pass@host:port). Иначе оставьте пустым.
HTTPS_PROXY=
NODE_USE_ENV_PROXY=
